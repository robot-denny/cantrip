# macOS
.DS_Store

# Temporal artifacts — gitignored wholesale
_scratch/

# Local Claude Code state (machine-specific paths, agent memory)
.claude/settings.local.json
.claude/agent-memory/
.claude/scheduled_tasks.lock

# Secrets
.env
.env.*
!.env.example

# Node (for tooling / plugin packaging later)
node_modules/
npm-debug.log*

# Python bytecode. The pack scripts are stdlib Python run in place, and `python3 -m
# py_compile <file>` -- this repo's compile gate -- writes a cache beside them. guide.py
# also sets sys.dont_write_bytecode, so a consuming project's installed skill directory
# stays clean; this covers the gate's own output.
__pycache__/
*.pyc
